# Copy to .env.local for local development and fill in the values.
# On Vercel, set these as Environment Variables on the project instead.
# Do not put real values in this file: it is committed to git.

# Random string used to encrypt the session cookie. Generate: npx auth secret
AUTH_SECRET=

# Microsoft Entra ID app registration (see README)
# Application (client) ID
AUTH_MICROSOFT_ENTRA_ID_ID=
# Client secret value
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
